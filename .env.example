# Copy to .env (git-ignored) and fill in. Without these, MatchLens uses its offline stand-in.
# Project endpoint: Foundry portal > your project > Overview, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# The *deployment* name of your model, from Models + endpoints (e.g. gpt-4.1-mini)
FOUNDRY_MODEL=
# Sign-in: "default" uses DefaultAzureCredential (run `az login` first);
# "browser" opens an interactive browser sign-in instead.
MATCHLENS_AUTH=default
